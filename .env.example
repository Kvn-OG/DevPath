# Integração OPCIONAL com Supabase. Sem estas variáveis o DevPath funciona 100% local.
# Copie para .env.local e preencha com os valores de Project Settings > API.
# Use SOMENTE a chave pública "anon" (publishable). NUNCA coloque a service_role key no front-end.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
